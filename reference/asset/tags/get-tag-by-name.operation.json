            "type": "string"
          }
        }
      }
    },
    "TagResponse": {
      "type": "object",
      "required": [
        "applicableProgramTypes",
        "required",
        "tagType"
      ],
      "properties": {
        "allowableValues": {
          "type": "string",
          "description": "The list of acceptable values for the tag type"
        },
