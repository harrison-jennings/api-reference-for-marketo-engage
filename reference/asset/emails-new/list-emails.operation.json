          }
        },
        "appData": {
          "$ref": "#/definitions/EmailAppDataResponseDTO"
        },
        "templateId": {
          "type": "string"
        },
        "externalId": {
          "type": "string"
        },
        "editorContext": {
          "$ref": "#/definitions/EditorContextDto"
        },
        "scriptEngine": {
          "type": "string"
        }
      },
      "title": "EmailContentDTO"
    },
    "EmailFilterResponse": {
