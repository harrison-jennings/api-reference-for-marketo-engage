          "$ref": "#/definitions/EmailFilterResult"
        }
      },
      "title": "EmailFilterResponse"
    },
    "EmailFilterResult": {
      "allOf": [
        {
          "$ref": "#/definitions/PageDetailsDTO"
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
