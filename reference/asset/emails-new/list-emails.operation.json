        },
        "errorMessage": {
          "type": "string"
        },
        "errorPosition": {
          "type": "object",
          "description": "Location in the content the entry refers to (for script/validation errors).",
          "properties": {
            "line": {
              "type": "integer",
              "format": "int32"
            },
            "column": {
              "type": "integer",
              "format": "int32"
            }
