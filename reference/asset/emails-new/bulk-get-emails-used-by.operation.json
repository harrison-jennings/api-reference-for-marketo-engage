            "in": "query",
            "description": "Token for Authorization",
            "required": true,
            "type": "string"
          },
          {
            "name": "x-app-type",
            "in": "header",
            "description": "Application type header",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "bulkUsedByRequest",
            "description": "bulkUsedByRequest",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BulkUsedByRequest"
            }
          }
        ],
        "responses": {
