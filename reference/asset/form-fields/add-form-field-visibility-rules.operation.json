          "type": "string"
        },
        "picklistFilterValues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PickListDTO"
          }
        },
        "subjectField": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FormVisibilityRuleResponse": {
      "type": "object",
      "properties": {
        "formFieldId": {
          "type": "string"
        },
        "ruleType": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
