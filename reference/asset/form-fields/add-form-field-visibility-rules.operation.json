        },
        "message": {
          "type": "string",
          "description": "Message describing the cause of the error"
        }
      }
    },
    "FormFieldVisibilityRequest": {
      "type": "object",
      "required": [
        "ruleType",
        "rules"
      ],
      "properties": {
        "ruleType": {
          "type": "string",
          "description": "Type of rule to apply",
          "enum": [
            "show",
            "alwaysShow",
            "hide"
          ]
        },
        "rules": {
