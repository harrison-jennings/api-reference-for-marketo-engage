  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/x-www-form-urlencoded"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/rest/asset/v1/smartList/{id}/autoSuggest.json": {
      "get": {
        "tags": [
          "Smart Lists"
        ],
        "summary": "Get Auto Suggest for Smart List",
        "description": "Returns suggested values for configuring a smart list rule. Required Permissions: Read-Only Assets, Read-Write Assets",
        "operationId": "getSmartListAutoSuggestUsingGET",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the smart list",
            "required": true,
            "type": "integer",
            "format": "int64"
          },
          {
            "name": "ruleTypeId",
            "in": "query",
            "description": "JSON representation of the rule type, with members 'id' and 'type' which may be 'activity' or 'attribute', for example {\"id\":11,\"type\":\"activity\"}",
            "required": true,
            "type": "string"
          },
          {
            "name": "optionTypeId",
            "in": "query",
            "description": "JSON representation of the constraint, with members 'id' and 'type' which may be 'activity' or 'attribute', for example {\"id\":16,\"type\":\"activity\"}",
            "required": true,
            "type": "string"
          },
          {
            "name": "primaryAttributeValue",
            "in": "query",
            "description": "Value used to filter suggestions",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/ResponseOfAutoSuggestValue"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AutoSuggestValue": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int32",
          "description": "Id of the suggested value"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the suggested value"
        },
        "name": {
          "type": "string",
          "description": "Name of the suggested value"
        },
        "workspace": {
          "type": "string",
          "description": "Name of the workspace containing the value"
        },
        "workspaceId": {
          "type": "integer",
          "format": "int32",
          "description": "Id of the workspace containing the value"
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "Error code of the error. See full list of error codes <a href=\"https://developers.marketo.com/rest-api/error-codes/\">here</a>"
        },
        "message": {
          "type": "string",
          "description": "Message describing the cause of the error"
        }
      }
    },
    "ResponseOfAutoSuggestValue": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Error"
          }
        },
        "requestId": {
          "type": "string"
        },
        "result": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/AutoSuggestValue"
            }
          },
          "description": "One array of suggested values"
        },
        "success": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
