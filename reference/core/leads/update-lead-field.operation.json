        "isHtmlEncodingInEmail": {
          "type": "boolean",
          "example": false,
          "description": "If set to true, field is encoded as HTML in email. Default is true"
        },
        "isSensitive": {
          "type": "boolean",
          "example": false,
          "description": "If set to true, field is marked as sensitive. Default is false"
