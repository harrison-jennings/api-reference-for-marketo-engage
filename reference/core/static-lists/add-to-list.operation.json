          "items": {
            "$ref": "#/definitions/ListOperationOutputData"
          }
        },
        "success": {
          "type": "boolean",
          "example": false,
          "description": "Whether the request succeeded"
        },
        "warnings": {
          "type": "array",
          "description": "Array of warnings given for the operation",
          "items": {
            "$ref": "#/definitions/Warning"
          }
        }
