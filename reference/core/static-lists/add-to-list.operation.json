        },
        "message": {
          "type": "string",
          "description": "Message describing the cause of the error"
        }
      }
    },
    "LeadInputData": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Unique integer id of a lead record"
        }
      },
      "description": "Lead record containing only lead id"
    },
    "ListOperationOutputData": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Unique integer id of a lead record"
        },
        "reasons": {
