---
import Base from "./Base.astro";
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} description={frontmatter.description} where={frontmatter.site}>
  <main class="page" id="main" data-pagefind-body data-pagefind-filter="kind:Guide" data-pagefind-meta={`where:${frontmatter.where}`}>
    <h1 id="top">{frontmatter.title}</h1>
    <div class="prose"><slot /></div>
  </main>
</Base>
