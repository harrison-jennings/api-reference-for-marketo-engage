---
import Footer from "../components/Footer.astro";
import JumpDialog from "../components/JumpDialog.astro";
import SiteLinks from "../components/SiteLinks.astro";
import TopBar from "../components/TopBar.astro";
import "../styles/site.css";
const SITE = "API Reference for Marketo Engage";
const ORIGIN = Astro.site;
const DEFAULT_DESCRIPTION = "An independent, searchable reference for the Adobe Marketo Engage APIs: every operation and model, with a request builder and mock responses.";
const { title, seoTitle, description = DEFAULT_DESCRIPTION, section, where, panes, navLabel, navAlways, builder = false, pane = "split", noindex = false, breadcrumbs = [], article = false } = Astro.props;
const fullTitle = seoTitle || (title === SITE ? SITE : `${title} | ${SITE}`);
const canonical = new URL(Astro.url.pathname, ORIGIN).href;
const image = new URL("/assets/images/social.png", ORIGIN).href;
const author = { "@type": "Person", name: "Harrison Jennings", url: "https://www.harrisonjennings.au/" };
const structured = [];
if (Astro.url.pathname === "/") structured.push({ "@context": "https://schema.org", "@type": "WebSite", name: SITE, url: canonical, description, inLanguage: "en-AU", publisher: author });
if (breadcrumbs.length) structured.push({ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: breadcrumbs.map((crumb, index) => ({ "@type": "ListItem", position: index + 1, name: crumb.name, ...(crumb.url ? { item: new URL(crumb.url, ORIGIN).href } : {}) })) });
if (article) structured.push({ "@context": "https://schema.org", "@type": "TechArticle", headline: title.slice(0, 110), description, url: canonical, inLanguage: "en-AU", author, publisher: author, isAccessibleForFree: true, image });
// "<" is escaped so the data can't close the script element.
const jsonLd = (data) => JSON.stringify(data).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="author" href="https://www.harrisonjennings.au/" />
    <meta name="author" content="Harrison Jennings" />
    <meta name="theme-color" content="#0B0D10" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={SITE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/images/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png" />
    {structured.map((data) => <script is:inline type="application/ld+json" set:html={jsonLd(data)}></script>)}
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("site-theme"); } catch (e) {}
        var chosen = stored === "light" || stored === "dark";
        var theme = chosen ? stored : matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body data-pane={pane} data-view="docs" data-nav="false">
    <TopBar section={section} where={where} panes={panes} navLabel={navLabel} navAlways={navAlways} />
    <slot />
    {!navLabel && (
      <Fragment>
        <div class="scrim" data-nav-toggle aria-hidden="true"></div>
        <div class="navwrap site-menu" id="nav-panel" tabindex="-1"><nav class="nav" aria-label="Menu"><button type="button" class="btn nav-close" data-nav-toggle>Close</button><SiteLinks section={section} /></nav></div>
      </Fragment>
    )}
    <Footer />
    <JumpDialog />
    {builder && <script is:inline type="module" src="/assets/request-builder/index.js"></script>}
    <script>
      import "../scripts/site.js";
      import "../scripts/jump.js";
    </script>
  </body>
</html>
