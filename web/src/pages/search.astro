---
import Base from "../layouts/Base.astro";
---
<Base title="Search" noindex description="Search the Marketo Engage API reference by operation name, operation ID, endpoint path, parameter or model.">
  <div class="twocol searchpage">
    <aside class="navwrap sfacets" id="search-facets-wrap" aria-label="Filter results"><div class="facets" id="search-facets"></div></aside>
    <main class="docs" id="main">
      <h1 id="top">Search</h1>
      <div class="sbox"><label class="sr" for="search-q">Search every page</label><input class="in" id="search-q" type="search" autocomplete="off" spellcheck="false" placeholder="Search every page" /><button type="button" class="btn" id="search-copy" aria-label="Copy link to this search">Copy link</button></div>
      <div class="tabs2" role="group" aria-label="Search in">
        <a id="tab-all" href="/search/" aria-current="page">All pages</a>
        <a id="tab-finder" href="/search/?tab=finder">Operation finder</a>
      </div>
      <details class="phone-filters" id="search-filters-phone"><summary class="gs">Filters</summary><div id="search-facets-phone" class="facets"></div></details>
      <p class="fc" id="search-status" role="status"></p>
      <div id="search-suggest"></div>
      <div class="reslist" id="search-results"></div>
      <div class="tscroll modelsbox" id="finder" tabindex="0" role="region" aria-label="Operations table" hidden><table class="tbl"><thead><tr><th>Method</th><th>Operation</th><th>Group</th><th>Path</th></tr></thead><tbody id="finder-rows"></tbody></table></div>
      <noscript><p>Search needs JavaScript. Browse the <a class="ln" href="/reference/">API reference</a> instead.</p></noscript>
    </main>
  </div>
  <script>import "../scripts/search.js";</script>
</Base>
