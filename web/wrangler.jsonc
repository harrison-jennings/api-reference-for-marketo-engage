{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static files only: no Worker script, so every request is a free static asset request. Cloudflare
  // Workers Builds builds and deploys this from GitHub (docs/architecture.md).
  "name": "mkto-ref",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Folders answer at a trailing slash (astro.config.mjs: trailingSlash "always"); anything else
    // redirects there. Missing files get 404.html with a 404, as on GitHub Pages.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Production is reached only through the mkto-ref.harrisonjennings.au route, never a public
  // workers.dev copy. Branch previews and version addresses are on workers.dev, behind Cloudflare Access.
  "workers_dev": false,
  "preview_urls": true,
}
